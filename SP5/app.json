{
  "expo": {
    "name": "Weather DB",
    "slug": "weather-db-sp",
    "version": "1.0.0",
    "scheme": "weathercities",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ua.volodymyr.weathersp5"
    },
    "android": {
      "package": "ua.duan.weathersp5",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ]
  }
}
